%% VLAAdapterGemma4 with SoftPromptLibrary (Stage 3 pretrain mode)
%% Trainable 675.236M / Frozen 5835M (Gemma 4 E2B 5104M + DINO+SigLIP 731M)
%% Red = FROZEN、Green = TRAINABLE

flowchart TB
    subgraph Inputs["Inputs (per batch)"]
        direction LR
        PV["pixel_values<br/>(dino, siglip)<br/>B×2×3×224×224"]
        IDS["input_ids<br/>B×L=599<br/>placeholder 込"]
        PROP["proprio<br/>B×8"]
        DS_ID["dataset_id<br/>B<br/>Stage 3 のみ"]
        ACT["actions (GT)<br/>B×8×7"]
    end

    subgraph VisionPath["Vision path"]
        VB["DINO+SigLIP backbone<br/>FROZEN 731M<br/>2-camera stack"]
        VP["VisionProjector<br/>TRAINABLE 32.78M<br/>2048 → 8192 → 1536 → 1536"]
        PV -->|primary+wrist| VB
        VB -->|B×512×2048| VP
        VP -->|B×512×1536| VH["vision_hidden"]
    end

    subgraph SoftPrompt["Soft Prompt Library (Stage 3)"]
        SPL["SoftPromptLibrary<br/>nn.Embedding(N_datasets, 32×1536)<br/>TRAINABLE 0.098M/dataset<br/>std=0.02 init"]
        DS_ID --> SPL
        SPL -->|B×32×1536| SP["soft_prompts"]
    end

    subgraph LLMInput["LLM input construction"]
        ET["Gemma4 embed_tokens<br/>vocab 256K"]
        IDS --> ET
        ET -->|B×599×1536| RE["raw_embeddings<br/>clone"]
        AQ["action_queries<br/>nn.Embedding(64, 1536)<br/>TRAINABLE 0.098M<br/>zero-init"]
        OW["Overwrite (R3 Option A):<br/>vision pos ← vision_hidden<br/>action pos ← action_queries"]
        RE --> OW
        VH --> OW
        AQ --> OW
        OW -->|B×599×1536| EMB["embeddings"]
        PREPEND["Prepend soft_prompts<br/>(案 B、inputs_embeds 前段)"]
        SP --> PREPEND
        EMB --> PREPEND
        PREPEND -->|"B×(32+599)×1536"| FINAL_EMB["final_embeddings"]

        PLE_CALC["get_per_layer_inputs<br/>(R2、事前計算 OOM 回避)"]
        IDS --> PLE_CALC
        PLE_CALC -->|B×599×35×256| PLE_RAW["per_layer_inputs<br/>raw"]
        PLE_PAD["zero-pad for soft_prompt"]
        PLE_RAW --> PLE_PAD
        PLE_PAD -->|"B×(32+599)×35×256"| PLE_FINAL["per_layer_inputs<br/>final"]

        ATTN_MASK["attention_mask<br/>all-ones<br/>B×(32+599)"]
        POS_IDS["position_ids<br/>0..Lp-1<br/>B×(32+599)"]
    end

    subgraph LLM["Gemma 4 E2B LLM — FROZEN 5104M (R4)"]
        GEMMA["35 hidden layers<br/>hidden_size=1536<br/>sliding_window=512<br/>num_kv_shared_layers=20<br/>use_cache=True (R6)<br/>no gradient_checkpointing (R6, HF issue 45242)<br/>attn_implementation=sdpa"]
        FINAL_EMB --> GEMMA
        PLE_FINAL --> GEMMA
        ATTN_MASK --> GEMMA
        POS_IDS --> GEMMA
        GEMMA -->|"36 × B × Lp × 1536"| HS["hidden_states<br/>(entries 0-35)"]
    end

    subgraph ActionHeadPath["Action Head input 組み立て"]
        HS_SLICE["entries 0-24 slice<br/>受容野 global layers 4,9,14,19 含む"]
        HS -->|"B×25×Lp×1536"| HS_SLICE
        SLICE_V["vision_hidden slice<br/>pos vpos0+32<br/>B×25×512×1536"]
        SLICE_A["action_hidden slice<br/>pos apos0+32<br/>B×25×64×1536"]
        HS_SLICE --> SLICE_V
        HS_SLICE --> SLICE_A
        FN["feature_norm<br/>Identity (Stage 1 1b.1 確定)"]
        SLICE_V --> FN
        SLICE_A --> FN
        CAT_HIDDEN["cat(vision, action, dim=2)<br/>B×25×576×1536"]
        FN --> CAT_HIDDEN
    end

    subgraph ActionHead["L1RegressionActionHead Pro"]
        AH["24 block × cross-attention + FiLM<br/>TRAINABLE 639.885M<br/>use_pro_version=True"]
        PP["ProprioProjector<br/>TRAINABLE 2.375M<br/>8 → 1536 → 1536"]
        CAT_HIDDEN --> AH
        PROP --> PP
        PP -->|B×1×1536| AH
        AH -->|B×8×7| PRED["predicted<br/>action chunk"]
    end

    subgraph Loss["Training Loss"]
        L1["F.l1_loss(predicted, actions)"]
        PRED --> L1
        ACT --> L1
        L1 --> LOSS["L1 scalar loss"]
    end

    %% Style (color coding)
    classDef frozen fill:#ffcccc,stroke:#cc0000,stroke-width:2px
    classDef trainable fill:#ccffcc,stroke:#00aa00,stroke-width:2px
    classDef compute fill:#e6f3ff,stroke:#0066cc,stroke-width:1px
    classDef io fill:#fff4cc,stroke:#cc9900,stroke-width:1px

    class VB,GEMMA frozen
    class VP,SPL,AQ,AH,PP trainable
    class ET,PLE_CALC,PLE_PAD,OW,PREPEND,HS_SLICE,SLICE_V,SLICE_A,FN,CAT_HIDDEN,L1 compute
    class PV,IDS,PROP,DS_ID,ACT,VH,SP,RE,EMB,FINAL_EMB,PLE_RAW,PLE_FINAL,ATTN_MASK,POS_IDS,HS,PRED,LOSS io
