%% VLAAdapterGemma4 Option (a): Bridge + scene concat (2026-04-24 #014 revised)
%% use_xvla_style=True、use_wrist_bridge=False、use_proper_ffn=False
%% Trainable 565 M / Frozen ~5.4 B (Gemma 4 E2B 2.6 B + SigLIP-So400m 400 M)
%% Red = FROZEN、Green = TRAINABLE、Blue = NEW in option (a)

flowchart TB
    subgraph Inputs["Inputs (per batch)"]
        direction LR
        SCENE["scene image<br/>B×3×224×224"]
        WRIST["wrist image<br/>B×3×224×224"]
        IDS["input_ids<br/>B×L=343<br/>[BOS]+prompt(20)+V(256)+P+A(64)+[EOS]"]
        PROP["proprio<br/>B×8"]
        ACT["actions (GT)<br/>B×8×7<br/>(BOUNDS_Q99 normalized)"]
    end

    subgraph VisionPath["Vision path"]
        SIGLIP["SigLIP-So400m ViT<br/>FROZEN 400 M<br/>patch14_224"]
        VPROJ["vision_projector<br/>TRAINABLE 16 M<br/>1152 → 8192 → 1536 → 1536"]
        SCENE -->|bf16| SIGLIP
        SIGLIP -->|B×256×1152| VPROJ
        VPROJ -->|B×256×1536| SCENE_TOK["scene_tokens"]
    end

    subgraph WristPath["Wrist path (bypass LLM)"]
        WRN["WristResNet18<br/>TRAINABLE 12 M<br/>ImageNet pretrained + proj<br/>(224×224 → 7×7=49 tokens × 1536)"]
        WRIST -->|ImageNet norm| WRN
        WRN -->|B×49×1536| HW["h_w"]
    end

    subgraph ProprioPath["Proprio path"]
        PP["ProprioProjector<br/>TRAINABLE 4.7 M<br/>Linear 8→1536 + GELU + Linear 1536→1536"]
        PP2["unsqueeze(dim=1)"]
        PROP --> PP
        PP --> PP2
        PP2 -->|B×1×1536| P_TOK["proprio_token"]
    end

    subgraph LLMInput["LLM input assembly (placeholder overwrite)"]
        ET["Gemma4 embed_tokens<br/>FROZEN (vocab 262K)"]
        IDS --> ET
        ET -->|B×343×1536| RE["raw_embeddings<br/>.clone()"]
        AQ["action_queries<br/>nn.Embedding(64, 1536)<br/>FROZEN zero-init (Mode B)"]
        OW["Overwrite:<br/>vision pos ← scene_tokens<br/>action pos ← action_queries"]
        RE --> OW
        SCENE_TOK --> OW
        AQ --> OW
        OW -->|B×343×1536| EMB["embeddings"]
    end

    subgraph LLMForward["Gemma 4 E2B LLM forward (frozen、torch.no_grad wrap in Mode B)"]
        LLM["Gemma4TextModel<br/>FROZEN 2.6 B<br/>35 layers, hidden=1536<br/>sliding window 512<br/>PLE + RMSNorm"]
        PLE["per_layer_inputs<br/>(PLE 事前計算)"]
        IDS --> PLE
        EMB --> LLM
        PLE --> LLM
        LLM -->|"output_hidden_states=True<br/>36 hidden [embed + 35 layers]"| ALL_H["all_hidden<br/>B×36×343×1536"]
    end

    subgraph BridgeFeatures["Per-layer feature extraction (Bridge baseline)"]
        SLICE["Slice first 25 layers<br/>all_hidden[:, :25, :, :]"]
        ALL_H --> SLICE
        H_T["h_t (task/scene)<br/>B×25×256×1536<br/>(vision positions × 25 layers)"]
        H_A["h_a (action)<br/>B×25×64×1536<br/>(action positions × 25 layers)"]
        SLICE --> H_T
        SLICE --> H_A
    end

    subgraph NEW_SceneFinal["★ Option (a) 新: final-layer scene (self-attn pool 用)"]
        FINAL["all_hidden[:, -1, vpos, :]"]
        ALL_H --> FINAL
        FINAL -->|B×256×1536| H_V["h_v<br/>scene final layer"]
    end

    subgraph ActionHead["ActionHead = L1RegressionActionHead (Bridge-style)"]
        direction TB
        X_INIT["x (action latent)<br/>zeros B×8×10752<br/>+ perturbation (train only)"]
        FC1["layer_norm1 + fc1 (10752→1536) + ReLU"]
        X_INIT --> FC1

        CAT["★concat to self-attn pool:<br/>x (8) ++ h_v (256) ++ h_w (49)<br/>= B×313×1536"]
        FC1 --> CAT
        H_V --> CAT
        HW --> CAT

        subgraph Block["× 24 MLPResNetBlock_Pro"]
            direction TB
            SELF_ATTN["Self-attn on x (313 tokens)<br/>q_proj / k_self / v_self<br/>RoPE"]
            X_ADAPTER["cross-attn → h_adapter = cat(h_a, p)<br/>k_adapter / v_adapter<br/>RoPE"]
            X_TASK["cross-attn → h_task = h_t<br/>k_task / v_task<br/>× tanh(gating_factor)<br/>RoPE"]
            CONCAT_ATTN["concat 3 streams' attention scores → softmax<br/>combine V"]
            O_PROJ["o_proj (1536→1536)"]
            FFN["ffn (legacy):<br/>LayerNorm + Linear(1536,1536) + ReLU<br/>x = ffn(attn_out + x)  (residual 置換)"]
            SELF_ATTN --> CONCAT_ATTN
            X_ADAPTER --> CONCAT_ATTN
            X_TASK --> CONCAT_ATTN
            CONCAT_ATTN --> O_PROJ
            O_PROJ --> FFN
        end
        CAT --> Block
        H_A -.->|per layer i+1| X_ADAPTER
        H_T -.->|per layer i+1| X_TASK
        P_TOK -.-> X_ADAPTER

        TRIM["Trim: x[:, :8, :]<br/>(action positions のみ残す)"]
        Block --> TRIM
        LN2["layer_norm2 + fc2 (1536→7)"]
        TRIM --> LN2
        LN2 -->|B×8×7 normalized actions| PREDICTED["predicted_actions"]
    end

    subgraph Loss["Loss (training)"]
        L1["F.l1_loss(predicted, actions)"]
        PREDICTED --> L1
        ACT --> L1
    end

    classDef frozen fill:#ffdede,stroke:#b33,stroke-width:1.5px
    classDef trainable fill:#d8f5d8,stroke:#363,stroke-width:1.5px
    classDef newbie fill:#d4e5ff,stroke:#36b,stroke-width:2px

    class SIGLIP,LLM,ET,AQ,PLE frozen
    class VPROJ,WRN,PP,PP2,FC1,Block,SELF_ATTN,X_ADAPTER,X_TASK,CONCAT_ATTN,O_PROJ,FFN,LN2 trainable
    class CAT,H_V,FINAL,NEW_SceneFinal newbie
