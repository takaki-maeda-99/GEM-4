%% VLAAdapterGemma4 Stage 2 (Phase 2f = 80% LIBERO-Spatial 達成 arch)
%% 2026-04-24 修正: Cross-Attention 内部構造 + FiLM 誤記述を是正
%% Trainable 675.138M / Frozen 5835M (Gemma 4 E2B 5104M + DINO+SigLIP 731M)
%% Red = FROZEN、Green = TRAINABLE
%% 注: Stage 3 (Soft Prompt 案 B) / Dual-Track redesign (scene-wrist split) とは別 arch

flowchart TB
    subgraph Inputs["Inputs (per batch)"]
        direction LR
        PV["pixel_values<br/>{dino, siglip} × {primary, wrist}<br/>B×2×3×224×224"]
        IDS["input_ids<br/>B×L=599<br/>[BOS]+V(512)+prompt(20)+P+A(64)+[EOS]<br/>(2026-04-26 vision-first)"]
        PROP["proprio<br/>B×8"]
        ACT["actions (GT)<br/>B×8×7<br/>BOUNDS_Q99 normalized"]
    end

    subgraph VisionPath["Vision path (2-camera fused)"]
        VB["DINO + SigLIP backbone<br/>FROZEN 731M<br/>primary + wrist を token 方向で concat"]
        VP["VisionProjector<br/>TRAINABLE 32.78M<br/>2048 → 8192 → 1536 → 1536"]
        PV -->|primary + wrist stacked| VB
        VB -->|B×512×2048| VP
        VP -->|B×512×1536| VH["vision_hidden"]
    end

    subgraph LLMInput["LLM input construction"]
        ET["Gemma4 embed_tokens<br/>FROZEN (vocab 256K)"]
        IDS --> ET
        ET -->|B×599×1536| RE["raw_embeddings (clone)"]
        AQ["action_queries<br/>nn.Embedding(64, 1536)<br/>TRAINABLE 0.098M<br/>zero-init"]
        OW["Overwrite (R3 Option A):<br/>vision pos ← vision_hidden<br/>action pos ← action_queries"]
        RE --> OW
        VH --> OW
        AQ --> OW
        OW -->|B×599×1536| EMB["inputs_embeds"]

        PLE_CALC["get_per_layer_inputs<br/>R2、事前計算 OOM 回避"]
        IDS --> PLE_CALC
        PLE_CALC -->|B×599×35×256| PLE["per_layer_inputs"]

        ATTN_MASK["attention_mask all-ones<br/>B×599"]
        POS_IDS["position_ids 0..598<br/>B×599"]
    end

    subgraph LLM["Gemma 4 E2B LLM — FROZEN 5104M (R4)"]
        GEMMA["35 hidden layers, hidden=1536<br/>sliding_window=512、num_kv_shared_layers=20<br/>use_cache=True (R6)、no GC (R6、HF #45242)<br/>attn_implementation=sdpa"]
        EMB --> GEMMA
        PLE --> GEMMA
        ATTN_MASK --> GEMMA
        POS_IDS --> GEMMA
        GEMMA -->|"36 × B × 599 × 1536"| HS["hidden_states<br/>entries 0-35"]
    end

    subgraph BridgeFeatures["Bridge per-layer feature extraction"]
        HS_SLICE["all_hidden[:, :25, :, :]<br/>global attn layers 4,9,14,19 含む"]
        HS -->|"B×36×599×1536"| HS_SLICE
        FN["feature_norm<br/>Identity (Stage 1 1b.1 確定)"]
        HS_SLICE --> FN
        HT_EXTRACT["h_t extract<br/>vision positions vpos0"]
        HA_EXTRACT["h_a extract<br/>action positions apos0"]
        FN --> HT_EXTRACT
        FN --> HA_EXTRACT
        HT_EXTRACT -->|"B×25×512×1536"| H_T["h_t<br/>(task stream: per-layer scene+wrist fused)"]
        HA_EXTRACT -->|"B×25×64×1536"| H_A["h_a<br/>(adapter stream: per-layer action)"]
    end

    subgraph ProprioPath["Proprio path"]
        PP["ProprioProjector<br/>TRAINABLE 2.375M<br/>Linear 8→1536 + GELU + Linear 1536→1536"]
        PROP --> PP
        PP -->|"B×1×1536"| P_FEAT["p (proprio feature)"]
    end

    subgraph ActionHead["L1RegressionActionHead (use_pro_version=True) — TRAINABLE 639.885M"]
        X_INIT["x (action latent)<br/>zeros B×8×10752<br/>+ perturbation (train only)"]
        FC1["layer_norm1 + fc1 10752→1536 + ReLU"]
        X_INIT --> FC1

        subgraph Block["24 × MLPResNetBlock_Pro (Stage 2 仕様)"]
            direction TB
            Q["q_proj(x)"]
            K_SELF["k_self(x), v_self(x)<br/>self-attn on 8 action tokens"]
            K_ADAPTER["k_adapter(h_adapter), v_adapter(h_adapter)<br/>h_adapter = cat(h_a_i, p)<br/>cross-attn to Bridge action hidden + proprio"]
            K_TASK["k_task(h_task), v_task(h_task)<br/>h_task = h_t_i (scene+wrist hidden)<br/>cross-attn to Bridge task hidden<br/>scaled by tanh(gating_factor)"]
            ROPE["RoPE (per-stream cos/sin)<br/>q·k^T / sqrt(head_dim=192)"]
            Q --> ROPE
            K_SELF --> ROPE
            K_ADAPTER --> ROPE
            K_TASK --> ROPE
            JOINT["concat 3 streams attn_scores<br/>→ joint softmax over 8 + 65 + 512 = 585 keys<br/>→ weighted combine V (v_self + v_adapter + v_task)"]
            ROPE --> JOINT
            O_PROJ["o_proj 1536→1536"]
            JOINT --> O_PROJ
            FFN["ffn (legacy 貧弱型):<br/>LayerNorm + Linear(1536, 1536) + ReLU<br/>★ x = ffn(attn_out + x)  (residual 置換、pre-LN 無し)"]
            O_PROJ --> FFN
        end
        FC1 --> Block
        H_A -.->|per layer i+1| K_ADAPTER
        P_FEAT -.-> K_ADAPTER
        H_T -.->|per layer i+1| K_TASK

        Trim["x[:, :8, :]<br/>action token のみ残す (trim、Stage 2 は no-op = 元々 8 tokens)"]
        Block --> Trim
        LN2["layer_norm2 + fc2 1536→7"]
        Trim --> LN2
        LN2 -->|"B×8×7 normalized action chunk"| PRED["predicted"]
    end

    subgraph Loss["Training Loss + Optimizer"]
        L1["F.l1_loss(predicted, actions_GT)"]
        PRED --> L1
        ACT --> L1
        L1 --> LOSS["L1 scalar loss"]
        OPT["AdamW<br/>lr=2e-4, wd=0.01, betas=(0.9, 0.999)<br/>warmup 500 step, MultiStepLR γ=0.1 @ step 100k<br/>clip_max_norm=1.0"]
        LOSS --> OPT
    end

    subgraph TrainConfig["Training Config (Phase 2e, 実測 80% @ 100k)"]
        TC["Dataset: LIBERO-Spatial single suite<br/>B=8, grad_accum=1, shuffle_buffer=256k<br/>max_steps=200000, save_freq=10k<br/>GPU: single A100-80GB<br/>No LoRA (R14 Stage 2 time scope 外)<br/>No DDP (single GPU)"]
    end

    %% Style
    classDef frozen fill:#ffcccc,stroke:#cc0000,stroke-width:2px
    classDef trainable fill:#ccffcc,stroke:#00aa00,stroke-width:2px
    classDef compute fill:#e6f3ff,stroke:#0066cc,stroke-width:1px
    classDef io fill:#fff4cc,stroke:#cc9900,stroke-width:1px
    classDef config fill:#f5f5f5,stroke:#666666,stroke-width:1px

    class VB,GEMMA,ET frozen
    class VP,AQ,PP,FC1,Q,K_SELF,K_ADAPTER,K_TASK,O_PROJ,FFN,LN2 trainable
    class PLE_CALC,OW,HS_SLICE,FN,HT_EXTRACT,HA_EXTRACT,ROPE,JOINT,Trim,L1,OPT compute
    class PV,IDS,PROP,ACT,VH,RE,EMB,PLE,ATTN_MASK,POS_IDS,HS,H_T,H_A,P_FEAT,PRED,LOSS io
    class TC config
